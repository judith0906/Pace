<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Contenedor central -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Solo el icono, con espacio para respirar -->
        <ImageView
            android:id="@+id/paceLogo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_pace_logo"
            android:contentDescription="Pace symbol" />

        <!-- "PACE" como texto independiente bajo el icono -->
        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pace"
            android:textSize="32sp"
            android:fontFamily="@font/rubik_regular"
            android:textColor="@color/accent_primary"
            android:letterSpacing="0.2"
            android:layout_marginTop="16dp" />

        <!-- Barra de progreso centrada bajo el texto -->
        <View
            android:id="@+id/progressLine"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="20dp"
            android:background="@color/accent_primary"
            android:alpha="0.3" />

    </LinearLayout>

    <!-- Firma -->
    <TextView
        android:id="@+id/novikonText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Novikon Productions"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:textColor="#FC5B5B5B" />

</FrameLayout>