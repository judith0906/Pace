<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nombre del grupo: editable inline con botón lápiz al lado del botón eliminar (solo admin) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/tv_group_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@null"
                android:enabled="false"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences" />

            <!-- Botón lápiz: solo visible para el admin. Activa la edición inline del nombre. -->
            <ImageButton
                android:id="@+id/btn_edit_name"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/group_rename_hint"
                android:visibility="gone"
                app:tint="@color/icon_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_group"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/delete_group"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="@color/error_red" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/group_join_code_label" />

        <TextView
            android:id="@+id/tv_join_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_members_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- Slider de máximo de miembros: solo visible para el admin, igual que en crear círculo -->
        <LinearLayout
            android:id="@+id/layout_admin_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_max_members"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Valor actual del slider, se actualiza en tiempo real al deslizar -->
            <TextView
                android:id="@+id/tv_max_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_max_members"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="2"
                android:valueTo="20"
                android:stepSize="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/save"
                android:textColor="@color/white"
                app:backgroundTint="@color/accent_primary" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/group_members_label"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_members"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_leave_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/leave_group"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/error_red" />

        <!-- Galería de fotos del círculo al estilo WhatsApp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/group_gallery_title"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_gallery_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/group_gallery_empty"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photo_gallery"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>