<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nombre del grupo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/tv_group_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@null"
                android:enabled="false"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences" />

            <ImageButton
                android:id="@+id/btn_edit_name"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/group_rename_hint"
                android:visibility="gone"
                app:tint="@color/icon_color" />

        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Código de invitación (solo admin) -->
        <LinearLayout
            android:id="@+id/layout_join_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_join_code_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_join_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_color"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

        <!-- Participantes y slider max (solo admin) -->
        <TextView
            android:id="@+id/tv_members_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layout_admin_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_max_members"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_max_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_max_members"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="3"
                android:valueTo="6"
                android:stepSize="1"
                app:trackColorActive="@color/text_secondary"
                app:trackColorInactive="@color/border_color"
                app:thumbColor="@color/text_secondary"
                app:tickColorActive="@color/white"
                app:tickColorInactive="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_max"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/save"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Miembros -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_members_label"
            android:textStyle="bold"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_members"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp" />

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Galería -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_gallery_title"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_gallery_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/group_gallery_empty"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_photo_gallery"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Botón eliminar círculo (solo admin) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_group"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/delete_group"
            android:textSize="13sp"
            android:visibility="gone"
            app:strokeColor="@color/error_red"
            android:textColor="@color/error_red" />

        <!-- Botón salir del grupo (solo miembro) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_leave_group"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/leave_group"
            android:textSize="13sp"
            android:visibility="gone"
            app:strokeColor="@color/error_red"
            android:textColor="@color/error_red" />

    </LinearLayout>
</ScrollView>