<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de mensaje enviado (propio) — alineada a la derecha -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp">

    <!-- Espacio en blanco a la izquierda para que la burbuja
         no ocupe todo el ancho, como en WhatsApp -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Burbuja -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:background="@drawable/bg_message_sent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Texto del mensaje -->
        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="2dp"/>

        <!-- Hora del mensaje — alineada a la derecha de la burbuja -->
        <TextView
            android:id="@+id/tv_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"/>

    </LinearLayout>

</LinearLayout>