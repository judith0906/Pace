<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/background_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Icono del dispositivo -->
        <ImageView
            android:id="@+id/deviceIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_person"
            android:contentDescription="Dispositivo"
            android:scaleType="centerInside"
            app:tint="@color/icon_color" />

        <!-- Info del dispositivo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Nombre del dispositivo + badge "Este dispositivo" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/deviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samsung Galaxy S23"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Badge visible solo en el dispositivo actual -->
                <TextView
                    android:id="@+id/thisDeviceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/active_devices_this_device"
                    android:textSize="11sp"
                    android:textColor="@color/accent_primary"
                    android:textStyle="bold"
                    android:background="@color/accent_secondary"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- OS -->
            <TextView
                android:id="@+id/deviceOs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android 14"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <!-- Último acceso -->
            <TextView
                android:id="@+id/deviceLastActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Último acceso: hace 2 minutos"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Botón cerrar sesión (oculto en este dispositivo) -->
        <ImageButton
            android:id="@+id/closeSessionButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logout"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar sesión"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"
            app:tint="@color/icon_color" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>