<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_color"
    app:cardBackgroundColor="@color/background_preview">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Icono del Grupo -->
        <ImageView
            android:id="@+id/groupIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_group_placeholder"
            android:contentDescription="Icono del grupo"
            android:scaleType="centerCrop"
            android:background="@drawable/group_icon_bg" />

        <!-- Nombre del Grupo -->
        <TextView
            android:id="@+id/groupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre del Grupo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.01"
            android:layout_marginStart="16dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Icono Flecha -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="Ver grupo"
            app:tint="@color/icon_color" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>